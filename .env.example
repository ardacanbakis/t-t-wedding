# Supabase project (Dashboard → Settings → API). Both values are public —
# they're baked into the static bundle; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Base path when hosted at username.github.io/<repo> (empty for custom domain)
NEXT_PUBLIC_BASE_PATH=

# Full site origin (no trailing slash) — used for social share preview URLs
# e.g. https://ardacanbakis.github.io
NEXT_PUBLIC_SITE_URL=
